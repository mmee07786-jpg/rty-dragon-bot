# --- أمر التايم أوت المطور بالشروط المحددة ---
@bot.command(name="t")
@commands.has_permissions(moderate_members=True)
async def timeout_member(ctx, member: discord.Member, time_str: str, *, reason=None):
    try:
        time_str = time_str.lower().strip()
        minutes_total = 0

        # الحالة الأولى: دقائق (مثال: 22m)
        if time_str.endswith('m'):
            val = int(time_str[:-1])
            if 1 <= val <= 50:
                minutes_total = val
            else:
                await ctx.send("خطأ: الدقائق يجب أن تكون بين **1 و 50** دقيقة فقط! ❌")
                return

        # الحالة الثانية: ساعات (مثال: h4 أو 4h -> ندعم كرتها h بالبداية مثل طلبك h4)
        elif time_str.startswith('h'):
            val = int(time_str[1:])
            if val >= 5:
                minutes_total = val * 60
            else:
                await ctx.send("خطأ: الحد الأدنى للساعات هو **5 ساعات** فما فوق! ❌")
                return
        elif time_str.endswith('h'):
            val = int(time_str[:-1])
            if val >= 5:
                minutes_total = val * 60
            else:
                await ctx.send("خطأ: الحد الأدنى للساعات هو **5 ساعات** فما فوق! ❌")
                return

        # الحالة الثالثة: أيام (مثال: d1 أو d2)
        elif time_str.startswith('d'):
            val = int(time_str[1:])
            if 1 <= val <= 2:
                minutes_total = val * 24 * 60
            else:
                await ctx.send("خطأ: الحد الأقصى للأيام هو **يومين فقط (d1 أو d2)**! ❌")
                return
        elif time_str.endswith('d'):
            val = int(time_str[:-1])
            if 1 <= val <= 2:
                minutes_total = val * 24 * 60
            else:
                await ctx.send("خطأ: الحد الأقصى للأيام هو **يومين فقط (d1 أو d2)**! ❌")
                return
        else:
            await ctx.send("صيغة الوقت غير صحيحة! استخدم الامثلة:\n`!t @user 22m`\n`!t @user h6`\n`!t @user d1` ❌")
            return

        duration = discord.utils.utcnow() + discord.timedelta(minutes=minutes_total)
        await member.timeout(duration, reason=reason)
        await ctx.send(f"تم إعطاء تايم أوت للعضو {member.mention} بنجاح مدة ` {time_str} ` ✅")

    except ValueError:
        await ctx.send("خطأ في قراءة الأرقام، تأكد من كتابة الأمر بالشكل الصحيح ❌")
    except discord.Forbidden:
        await ctx.send("يجب إعطاء البوت صلاحيات كافية لاستخدام هذا الإجراء ❌")

@timeout_member.error
async def timeout_error(ctx, error):
