import os
import discord
from discord.ext import commands

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f"تم تشغيل البوت بنجاح باسم {bot.user}")
    await bot.change_presence(activity=discord.Game(name="I see you"))

@bot.command(name="k")
@commands.has_permissions(kick_members=True)
async def kick_member(ctx, member: discord.Member, *, reason=None):
    try:
        await member.kick(reason=reason)
        await ctx.send(f"تم طرد العضو {member.mention} بنجاح ✅")
    except discord.Forbidden:
        await ctx.send("يجب إعطاء البوت صلاحيات كافية لاستخدام هذا الإجراء ❌")

@timeout_member.error
async def timeout_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send("عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر التايم أوت ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("الرجاء كتابة الأمر بشكل صحيح `!t @user <minutes>` ❌")

@bot.command(name="b")
@commands.has_permissions(ban_members=True)
async def ban_member(ctx, member: discord.Member, *, reason=None):
    try:
        await member.ban(reason=reason)
        await ctx.send(f"تم حظر العضو {member.mention} نهائياً 🚷❌")
    except discord.Forbidden:
        await ctx.send("يجب إعطاء البوت صلاحيات كافية لاستخدام هذا الإجراء ❌")

@ban_member.error
async def ban_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send("عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر الحظر ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("الرجاء كتابة الأمر بشكل صحيح `!b @user` ❌")

token = os.environ.get("DISCORD_TOKEN")
if token:
    bot.run(token)
else:
    print("خطأ: لم يتم العثور على التوكن!")
