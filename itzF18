    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("الرجاء كتابة الأمر بشكل صحيح `!k @user` ❌")

# --- أمر التايم أوت المحدث بالكامل (يدعم الأرقام الحرة) ---
@bot.command(name="t")
@commands.has_permissions(moderate_members=True)
async def timeout_member(ctx, member: discord.Member, time_input: str, *, reason=None):
    try:
        time_input = time_input.lower().strip()
        minutes = 0

        # إذا كتب رقم صافي بدون حروف (مثل 5 أو 10) نعتبرها دقائق تلقائياً
        if time_input.isdigit():
            minutes = int(time_input)
        elif time_input.endswith('m'):
            minutes = int(time_input[:-1])
        elif time_input.endswith('h'):
            minutes = int(time_input[:-1]) * 60
        elif time_input.endswith('d'):
            minutes = int(time_input[:-1]) * 1440
        else:
            await ctx.send("صيغة الوقت غير صحيحة! اكتب رقماً مباشراً (مثل `10` للدقائق) أو مع حرف (`2h` للساعات) ❌")
            return

        duration = discord.utils.utcnow() + discord.timedelta(minutes=minutes)
        await member.timeout(duration, reason=reason)
        await ctx.send(f"تم إعطاء تايم أوت للعضو {member.mention} بنجاح لمدة `{minutes} دقائق` ✅")

    except ValueError:
        await ctx.send("خطأ: يرجى كتابة رقم صحيح للوقت ❌")
    except discord.Forbidden:
        await ctx.send("فشل الإجراء: تأكد أن رتبة البوت أعلى من رتبة العضو المراد إسكاته ❌")

@timeout_member.error
async def timeout_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send("عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر الإسكات ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("الرجاء كتابة الأمر بشكل صحيح مع تحديد الوقت (مثال: `!t @user 10`) ❌")

