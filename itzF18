import os
import discord
from discord.ext import commands

intents = discord.Intents.default()
intents.message_content = True
intents.guilds = True
intents.members = True

bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f"تم تشغيل البوت بنجاح باسم {bot.user}")
    await bot.change_presence(activity=discord.Game(name="I see you"))

@bot.event
async def on_guild_join(guild):
    try:
        owner = guild.owner or await guild.fetch_owner()
        if owner:
            embed = discord.Embed(
                title="✨ | هلا بيك نورت السيرفر",
                description=(
                    f"يا هلا فيك! شكراً لإضافتك بوت `itzF18` إلى سيرفرك **{guild.name}**.\n\n"
                    "بوت عربي متكامل تم تصميمه ليجعل إدارة وحماية السيرفر أسهل وأمتع 🛡️\n\n"
                    "📋 **قائمة الأوامر وكيفية استخدامها:**\n"
                    "🔹 **1. أمر الطرد (`!k`):**\n"
                    "   - الاستخدام: `!k @user`\n"
                    "   - الوظيفة: طرد العضو المخالف.\n\n"
                    "🔹 **2. أمر الإسكات (`!t`):**\n"
                    "   - الاستخدام: `!t @user <الدقائق>`\n"
                    "   - الوظيفة: تقييد وإسكات العضو لفترة محددة.\n\n"
                    "🔹 **3. أمر الحظر (`!b`):**\n"
                    "   - الاستخدام: `!b @user`\n"
                    "   - الوظيفة: حظر العضو نهائياً من السيرفر.\n\n"
                    "🚀 **تحديثات قادمة قريباً إن شاء الله:**\n"
                    "نحن نعمل على تطوير ميزات وأوامر جديدة متطورة ترقبوها قريباً جداً!\n\n"
                    "جربني وما راح تندم، شكراً لثقتك ولانضمامك 🤍"
                ),
                color=0x000000  # الشريط الجانبي باللون الأسود
            )
            embed.set_footer(text="itzF18 Bot • 24/7 Online")
            await owner.send(embed=embed)
    except Exception as e:
        print(f"خطأ في إرسال رسالة الترحيب: {e}")

@bot.command(name="k")
@commands.has_permissions(kick_members=True)
async def kick_member(ctx, member: discord.Member, *, reason=None):
    try:
        await member.kick(reason=reason)
        await ctx.send(f"تم طرد العضو {member.mention} بنجاح ✅")
    except discord.Forbidden:
        await ctx.send("يجب إعطاء البوت صلاحيات كافية لاستخدام هذا الإجراء ❌")

@kick_member.error
async def kick_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send("عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر الطرد ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("الرجاء كتابة الأمر بشكل صحيح `!k @user` ❌")

@bot.command(name="t")
@commands.has_permissions(moderate_members=True)
async def timeout_member(ctx, member: discord.Member, minutes: int, *, reason=None):
    try:
        duration = discord.utils.utcnow() + discord.timedelta(minutes=minutes)
        await member.timeout(duration, reason=reason)
        await ctx.send(f"تم إسكات العضو {member.mention} لمدة {minutes} دقائق ✅")
    except discord.Forbidden:
        await ctx.send("يجب إعطاء البوت صلاحيات كافية لاستخدام هذا الإجراء ❌")

@timeout_member.error
async def timeout_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send("عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر التايم أوت ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("الرجاء كتابة الأمر بشكل صحيح `!t @user <minutes>` ❌")

@bot.command(name="b")
@commands.has_permissions(ban_members=True)
async def ban_member(ctx, member: discord.Member, *, reason=None):
    try:
        await member.ban(reason=reason)
        await ctx.send(f"تم حظر العضو {member.mention} نهائياً 🚷❌")
    except discord.Forbidden:
        await ctx.send("يجب إعطاء البوت صلاحيات كافية لاستخدام هذا الإجراء ❌")

@ban_member.error
async def ban_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send("عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر الحظر ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send("الرجاء كتابة الأمر بشكل صحيح `!b @user` ❌")

token = os.environ.get("DISCORD_TOKEN")
if token:
    bot.run(token)
else:
    print("خطأ: لم يتم العثور على التوكن!")
