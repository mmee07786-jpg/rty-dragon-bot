import os
import subprocess
import sys
import time

BOT_SCRIPT = "bot_core.py"


def run_process():
  code_content = """import discord
from discord.ext import commands

intents = discord.Intents.default()
intents.message_content = True
bot = commands.Bot(command_prefix="!", intents=intents)

@bot.event
async def on_ready():
    print(f"تم تشغيل البوت بنجاح باسم {bot.user}")
    await bot.change_presence(activity=discord.Game(name="VALTRYX 🛡️"))

# أمر الطرد: !k @user
@bot.command(name="k")
@commands.has_permissions(kick_members=True)
async def kick_member(ctx, member: discord.Member, *, reason=None):
    try:
        await member.kick(reason=reason)
        await ctx.send(f"عذراً يا بطل، تم طرد العضو {member.mention} بنجاح ✅\\nSorry hero, member {member.mention} has been successfully kicked ✅")
    except discord.Forbidden:
        await ctx.send(f"عذراً، يجب إعطاء البوت صلاحيات لاستخدام هذا الإجراء ❌\\nSorry, the bot must be given permissions to use this action ❌")

@kick_member.error
async def kick_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send(f"عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر الطرد ❌\\nSorry, you do not have permission to use the kick command ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send(f"الرجاء كتابة الأمر بشكل صحيح مع منشن العضو: `!k @العضو` ❌\\nPlease write the command correctly with a member mention: `!k @member` ❌")

# أمر التايم أوت: !t @user <الدقائق>
@bot.command(name="t")
@commands.has_permissions(moderate_members=True)
async def timeout_member(ctx, member: discord.Member, minutes: int, *, reason=None):
    try:
        duration = discord.utils.utcnow() + discord.timedelta(minutes=minutes)
        await member.timeout(duration, reason=reason)
        await ctx.send(f"تم إسكات العضو {member.mention} لمدة {minutes} دقائق بنجاح ✅\\nMember {member.mention} has been timed out for {minutes} minutes successfully ✅")
    except discord.Forbidden:
        await ctx.send(f"عذراً، يجب إعطاء البوت صلاحيات لاستخدام هذا الإجراء ❌\\nSorry, the bot must be given permissions to use this action ❌")

@timeout_member.error
async def timeout_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send(f"عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر التايم أوت ❌\\nSorry, you do not have permission to use the timeout command ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send(f"الرجاء كتابة الأمر بشكل صحيح: `!t @العضو الوقت_بالدقائق` ❌\\nPlease write the command correctly: `!t @member minutes` ❌")

# أمر الباند: !b @user
@bot.command(name="b")
@commands.has_permissions(ban_members=True)
async def ban_member(ctx, member: discord.Member, *, reason=None):
    try:
        await member.ban(reason=reason)
        await ctx.send(f"تم حظر العضو {member.mention} نهائياً خارج السيرفر ولن يعود أبداً 🚷❌\\nMember {member.mention} has been permanently banned from the server and will never return 🚷❌")
    except discord.Forbidden:
        await ctx.send(f"عذراً، يجب إعطاء البوت صلاحيات لاستخدام هذا الإجراء ❌\\nSorry, the bot must be given permissions to use this action ❌")

@ban_member.error
async def ban_error(ctx, error):
    if isinstance(error, commands.MissingPermissions):
        await ctx.send(f"عذراً، لا تمتلك الصلاحيات الكافية لاستخدام أمر الحظر ❌\\nSorry, you do not have permission to use the ban command ❌")
    elif isinstance(error, commands.MissingRequiredArgument):
        await ctx.send(f"الرجاء كتابة الأمر بشكل صحيح مع منشن العضو: `!b @العضو` ❌\\nPlease write the command correctly with a member mention: `!b @member` ❌")

token = os.environ.get("DISCORD_TOKEN")
if token:
    bot.run(token)
else:
    print("خطأ: لم يتم العثور على التوكن (DISCORD_TOKEN)!")
"""

  with open(BOT_SCRIPT, "w", encoding="utf-8") as f:
    f.write(code_content)

  while True:
    print("Starting bot...")
    p = subprocess.Popen([sys.executable, BOT_SCRIPT])
    p.wait()
    print("Bot crashed or stopped. Restarting in 3 seconds...")
    time.sleep(3)


if __name__ == "__main__":
  run_process()

